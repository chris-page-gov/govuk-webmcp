{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:govuk-webmcp:schema:federated-provenance-result:v1",
  "title": "Federated source-snapshot provenance result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "ok", "evidenceTier", "recordId", "status", "observationDate", "sourceLock", "sourceDigest",
    "recordDigest", "bundleDigest", "snapshot", "revision", "sourcePath", "sourceFileDigest",
    "evidenceReceiptAvailable", "collection", "authoritativeLink", "fieldAssertions", "limitations", "boundaries"
  ],
  "properties": {
    "schema": { "const": "govuk-webmcp.federated-provenance-result.v1" },
    "ok": { "const": true },
    "evidenceTier": { "const": "federated-source-snapshot" },
    "recordId": { "type": "string", "maxLength": 160, "pattern": "^govuk-discovery:federated:(?:uk-living|ons|government-apis|land-registry):(0|[1-9][0-9]{0,5})$" },
    "status": { "const": "federated-source-linked" },
    "observationDate": { "type": "string", "format": "date-time" },
    "sourceLock": { "$ref": "#/$defs/sha256" },
    "sourceDigest": { "$ref": "#/$defs/sha256" },
    "recordDigest": { "$ref": "#/$defs/sha256" },
    "bundleDigest": { "$ref": "#/$defs/sha256" },
    "snapshot": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 200 }, { "type": "null" }] },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sourcePath": { "$ref": "urn:govuk-webmcp:schema:federated-record-shard:v1#/$defs/storedRecord/properties/sourcePath" },
    "sourceFileDigest": { "$ref": "#/$defs/sha256" },
    "evidenceReceiptAvailable": { "const": false },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "descriptorUrl", "snapshot", "revision", "deploymentId", "sourceNativeId", "sourceNativeIdSha256"],
      "properties": {
        "id": { "enum": ["uk-living", "ons", "government-apis", "land-registry"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "descriptorUrl": { "$ref": "#/$defs/httpsUrl" },
        "snapshot": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 200 }, { "type": "null" }] },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "deploymentId": { "type": "string", "minLength": 3, "maxLength": 160 },
        "sourceNativeId": { "type": "string", "minLength": 1, "maxLength": 500 },
        "sourceNativeIdSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "authoritativeLink": { "$ref": "urn:govuk-webmcp:schema:federated-record-shard:v1#/$defs/authorityLink" },
    "fieldAssertions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "status", "note"],
        "properties": {
          "field": { "const": "record" },
          "status": { "enum": ["producer-declared", "normalised", "inferred", "model-derived", "unclassified"] },
          "note": { "const": "Producer-derived source-snapshot assertion; no item-level evidence receipt is claimed." }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sameOriginSnapshotVerified", "sourceWasNotRefetchedAtRuntime", "itemLevelReview", "evidenceReceiptAvailable",
        "cryptographicSignatureVerified", "accessAuthorityGranted", "sourceDerivedContentIsUntrusted"
      ],
      "properties": {
        "sameOriginSnapshotVerified": { "const": true },
        "sourceWasNotRefetchedAtRuntime": { "const": true },
        "itemLevelReview": { "const": false },
        "evidenceReceiptAvailable": { "const": false },
        "cryptographicSignatureVerified": { "const": false },
        "accessAuthorityGranted": { "const": false },
        "sourceDerivedContentIsUntrusted": { "const": true }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://[^/@:]+(?:/|$)" }
  }
}
