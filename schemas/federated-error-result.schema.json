{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:govuk-webmcp:schema:federated-error-result:v1",
  "title": "Internal federated runtime error result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ok", "error", "limitations"],
  "properties": {
    "schema": { "const": "govuk-webmcp.federated-error.v1" },
    "ok": { "const": false },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "details"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9_]+$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "recordId": { "type": "string", "maxLength": 160 }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    }
  }
}
