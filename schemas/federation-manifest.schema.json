{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:govuk-webmcp:schema:federation-manifest:v1",
  "title": "Federated corpus admission manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generatedAt", "catalogueBundleDigest", "admissionSourceDigest", "federatedSearch", "collections", "manifestDigest"],
  "properties": {
    "schema": { "const": "govuk-webmcp.corpus-admission.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "catalogueBundleDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "admissionSourceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "federatedSearch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceLockSha256", "sourceLockDigest", "sourceRecordCount", "quarantinedRecordCount", "recordCount", "collectionBindings"],
      "properties": {
        "sourceLockSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sourceLockDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sourceRecordCount": { "const": 58655 },
        "quarantinedRecordCount": { "const": 3 },
        "recordCount": { "const": 58652 },
        "collectionBindings": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "allOf": [
                { "$ref": "#/$defs/collectionBinding" },
                { "type": "object", "properties": {
                  "admissionId": { "const": "corpus:uk-life-course" },
                  "collectionId": { "const": "uk-living" },
                  "sourceRecordCount": { "const": 9757 },
                  "quarantinedRecordCount": { "const": 0 },
                  "recordCount": { "const": 9757 }
                } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/collectionBinding" },
                { "type": "object", "properties": {
                  "admissionId": { "const": "corpus:ons-metadata" },
                  "collectionId": { "const": "ons" },
                  "sourceRecordCount": { "const": 5097 },
                  "quarantinedRecordCount": { "const": 0 },
                  "recordCount": { "const": 5097 }
                } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/collectionBinding" },
                { "type": "object", "properties": {
                  "admissionId": { "const": "corpus:uk-government-apis" },
                  "collectionId": { "const": "government-apis" },
                  "sourceRecordCount": { "const": 41598 },
                  "quarantinedRecordCount": { "const": 0 },
                  "recordCount": { "const": 41598 }
                } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/collectionBinding" },
                { "type": "object", "properties": {
                  "admissionId": { "const": "corpus:land-registry-metadata" },
                  "collectionId": { "const": "land-registry" },
                  "sourceRecordCount": { "const": 2203 },
                  "quarantinedRecordCount": { "const": 3 },
                  "recordCount": { "const": 2200 }
                } }
              ]
            }
          ],
          "items": false
        }
      }
    },
    "collections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["admission", "entryDigest"],
        "properties": {
          "admission": { "$ref": "urn:govuk-webmcp:schema:corpus-admission-source:v1#/$defs/collection" },
          "entryDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "manifestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "collectionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admissionId", "collectionId", "sourceRecordCount", "quarantinedRecordCount", "recordCount"],
      "properties": {
        "admissionId": { "type": "string", "pattern": "^corpus:[a-z0-9][a-z0-9-]{2,80}$" },
        "collectionId": { "enum": ["uk-living", "ons", "government-apis", "land-registry"] },
        "sourceRecordCount": { "type": "integer", "minimum": 1, "maximum": 58655 },
        "quarantinedRecordCount": { "type": "integer", "minimum": 0, "maximum": 3 },
        "recordCount": { "type": "integer", "minimum": 1, "maximum": 58652 }
      }
    }
  }
}
