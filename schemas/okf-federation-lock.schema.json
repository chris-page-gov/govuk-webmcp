            "searchManifest": { "const": { "path": "data/search/manifest.json", "bytes": 74160, "sha256": "8586ef20a136340509b20814fa5bf12c0bc88c6c36c8f50d5ac9c2efb426ccb5", "schema": "okf-static-search.v1" } },
