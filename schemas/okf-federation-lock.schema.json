            "dataManifest": { "const": { "path": "large/data/manifest.json", "bytes": 1590, "sha256": "fe0e11219ceec88702ca8a5d536d6d0ac0425f3bb29c7586884cfb0e56c957b4" } },
            "searchManifest": { "const": { "path": "large/data/search/manifest.json", "bytes": 13344, "sha256": "112608e17bca06d6b92313dbcdcff1f1798a2bfdc2cb11724a3d26b88d3d5e26", "schema": "okf-static-search.v1" } },
            "population": { "const": { "records": 9757, "unit": "search documents", "serviceFamilies": 293, "resources": 879 } },
