            "access": { "const": { "status": "public-static-metadata", "statement": "Metadata discovery only; source endpoints and selection requirements remain producer-controlled." } },
            "limitations": { "const": ["The snapshot contains metadata from four declared adapters, not current statistical observations.", "The repository revision does not by itself reproduce the ignored generated Pages bundle; its deployed bytes are locked separately.", "A result does not establish statistical accuracy, currentness, endpoint access or permission to reuse linked material."] }
          }
        }
      ]
    },
    "governmentApis": {
      "allOf": [
        { "$ref": "#/$defs/source" },
        {
