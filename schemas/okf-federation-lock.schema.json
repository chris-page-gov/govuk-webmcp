{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:govuk-webmcp:schema:okf-federation-lock:v1",
  "title": "Checksum-bound OKF federation source lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile", "evidenceTier", "authoredAt", "aggregate", "sources", "lockDigest"],
  "properties": {
    "schema": { "const": "govuk-webmcp.okf-federation-lock.v1" },
    "profile": { "const": "govuk-webmcp.okf-federated-search.v1" },
    "evidenceTier": { "const": "federated-source-snapshot" },
    "authoredAt": { "type": "string", "format": "date-time" },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceCount", "recordCount", "artifactCount", "decodedArtifactBytes", "storedArtifactBytes", "sourceIdentityDigest", "aggregateDigest"],
      "properties": {
        "sourceCount": { "const": 4 },
        "recordCount": { "const": 58655 },
        "artifactCount": { "const": 73 },
        "decodedArtifactBytes": { "type": "integer", "minimum": 1, "maximum": 471859200 },
        "storedArtifactBytes": { "type": "integer", "minimum": 1, "maximum": 33554432 },
        "sourceIdentityDigest": { "$ref": "#/$defs/sha256" },
        "aggregateDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "$ref": "#/$defs/ukLiving" },
        { "$ref": "#/$defs/ons" },
        { "$ref": "#/$defs/governmentApis" },
        { "$ref": "#/$defs/landRegistry" }
      ],
      "items": false
    },
    "lockDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*//)(?!.*[%?#\\\\])(?!.*/(?:\\.\\.?)(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/safePath" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "searchReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "schema"],
      "properties": {
        "path": { "$ref": "#/$defs/safePath" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "schema": { "enum": ["okf-static-search.v1", "okf-static-search.v2"] }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "sourcePath", "storedPath", "sourceBytes", "sourceSha256", "storedBytes", "storedSha256", "compression", "itemCount"],
      "properties": {
        "role": { "enum": ["records", "resources", "supporting"] },
        "sourcePath": { "$ref": "#/$defs/safePath" },
        "storedPath": {
          "allOf": [
            { "$ref": "#/$defs/safePath" },
            { "type": "string", "pattern": "^app/data/sources/okf-federation/(?:uk-living|ons|government-apis|land-registry)/(?:records|resources|supporting)-[0-9]{3}\\.json\\.gz$" }
          ]
        },
        "sourceBytes": { "type": "integer", "minimum": 2, "maximum": 16777216 },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "storedBytes": { "type": "integer", "minimum": 2, "maximum": 16777216 },
        "storedSha256": { "$ref": "#/$defs/sha256" },
        "compression": { "const": "gzip" },
        "itemCount": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      }
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": ["records", "unit"],
      "properties": {
        "records": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "unit": { "const": "search documents" },
        "serviceFamilies": { "type": "integer", "minimum": 0 },
        "resources": { "type": "integer", "minimum": 0 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "repositoryUrl", "baseUrl", "deploymentId", "revision", "revisionReproducibility", "snapshot", "descriptor", "dataManifest", "searchManifest", "population", "recordArtifacts", "supportingArtifacts", "requestPolicy", "budgets", "rights", "access", "limitations", "boundaries", "entryDigest"],
      "properties": {
        "id": { "enum": ["uk-living", "ons", "government-apis", "land-registry"] },
        "title": { "type": "string", "minLength": 3, "maxLength": 160 },
        "repositoryUrl": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/chris-page-gov/" },
        "baseUrl": { "type": "string", "format": "uri", "pattern": "^https://chris-page-gov\\.github\\.io/" },
        "deploymentId": { "type": "string", "minLength": 3, "maxLength": 160 },
        "revision": { "$ref": "#/$defs/revision" },
        "revisionReproducibility": { "enum": ["exact-repository-revision", "deployed-bytes-observed-separately"] },
        "snapshot": { "type": ["string", "null"], "maxLength": 200 },
        "descriptor": { "$ref": "#/$defs/reference" },
        "dataManifest": { "$ref": "#/$defs/reference" },
        "searchManifest": { "$ref": "#/$defs/searchReference" },
        "population": { "$ref": "#/$defs/population" },
        "recordArtifacts": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/artifact" } },
        "supportingArtifacts": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/artifact" } },
        "requestPolicy": {
          "const": { "credentials": "omit", "redirect": "error", "sameOriginOnly": true }
        },
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maximumResourceBytes", "maximumDecodedBytes", "maximumStoredBytes", "maximumArtifacts"],
          "properties": {
            "maximumResourceBytes": { "const": 16777216 },
            "maximumDecodedBytes": { "type": "integer", "minimum": 1, "maximum": 471859200 },
            "maximumStoredBytes": { "type": "integer", "minimum": 1, "maximum": 33554432 },
            "maximumArtifacts": { "type": "integer", "minimum": 1, "maximum": 64 }
          }
        },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "statement"],
          "properties": {
            "status": { "enum": ["source-specific", "not-established"] },
            "statement": { "type": "string", "minLength": 10, "maxLength": 700 }
          }
        },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "statement"],
          "properties": {
            "status": { "const": "public-static-metadata" },
            "statement": { "type": "string", "minLength": 10, "maxLength": 700 }
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "type": "string", "minLength": 10, "maxLength": 700 }
        },
        "boundaries": {
          "const": { "officialApiCalls": false, "personalContextAccepted": false, "sourceDerivedContentIsUntrusted": true }
        },
        "entryDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "ukLiving": {
      "allOf": [
        { "$ref": "#/$defs/source" },
