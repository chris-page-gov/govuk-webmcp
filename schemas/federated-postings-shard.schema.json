{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:govuk-webmcp:schema:federated-postings-shard:v1",
  "title": "Checksum-bound federated postings shard",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "collectionId", "prefix", "part", "entries"],
  "properties": {
    "schema": { "const": "govuk-webmcp.federated-postings-shard.v1" },
    "collectionId": { "enum": ["uk-living", "ons", "government-apis", "land-registry"] },
    "prefix": { "type": "string", "pattern": "^(?:_|[a-z0-9]{1,2})$" },
    "part": { "type": "integer", "minimum": 0, "maximum": 15 },
    "entries": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 100000,
      "propertyNames": {
        "type": "string",
        "minLength": 2,
        "maxLength": 500,
        "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,498}[a-z0-9])?$"
      },
      "patternProperties": {
        "^[a-z0-9](?:[a-z0-9._-]{0,498}[a-z0-9])?$": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5000000,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "prefixItems": [
              { "type": "integer", "minimum": 0, "maximum": 58651 },
              { "type": "integer", "minimum": 1, "maximum": 1000 },
              { "type": "integer", "minimum": 1, "maximum": 63 }
            ],
            "items": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
