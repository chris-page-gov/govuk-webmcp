{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/get-resource-record-output.schema.json",
  "title": "get_resource_record output",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "ok", "verificationStatus", "record", "relatedRecords", "boundaries"],
      "properties": {
        "schema": { "const": "trusted-govuk-discovery.resource-record-result.v1" },
        "ok": { "const": true },
        "verificationStatus": { "const": "digest-bound" },
        "record": { "$ref": "urn:govuk-webmcp:schema:profile-record:v1" },
        "relatedRecords": { "type": "array", "maxItems": 8, "items": { "$ref": "urn:govuk-webmcp:schema:public-record-summary:v1" } },
        "boundaries": {
          "type": "object", "additionalProperties": false,
          "required": ["pageScoped", "readOnly", "providerCall", "accessAuthorityGranted", "sourceDerivedContentIsUntrusted"],
          "properties": {
            "pageScoped": { "const": true },
            "readOnly": { "const": true },
            "providerCall": { "const": false },
            "accessAuthorityGranted": { "const": false },
            "sourceDerivedContentIsUntrusted": { "const": true }
          }
        }
      }
    },
    { "$ref": "urn:govuk-webmcp:schema:federated-resource-record-result:v1" },
    { "$ref": "urn:govuk-webmcp:schema:error-result:v1" }
  ]
}
