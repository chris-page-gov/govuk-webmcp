{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/search-government-knowledge-output.schema.json",
  "title": "search_government_knowledge output",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "ok", "query", "catalogue", "totalMatches", "returned", "truncated", "results", "boundaries"],
      "properties": {
        "schema": { "const": "trusted-govuk-discovery.search-result.v1" },
        "ok": { "const": true },
        "query": { "type": "string", "minLength": 1, "maxLength": 160 },
        "catalogue": {
          "type": "object", "additionalProperties": false,
          "required": ["generatedAt", "bundleDigest", "recordCount"],
          "properties": {
            "generatedAt": { "type": "string", "format": "date-time" },
            "bundleDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "recordCount": { "type": "integer", "minimum": 30, "maximum": 80 }
          }
        },
        "totalMatches": { "type": "integer", "minimum": 0, "maximum": 80 },
        "returned": { "type": "integer", "minimum": 0, "maximum": 20 },
        "truncated": { "type": "boolean" },
        "results": { "type": "array", "maxItems": 20, "items": { "$ref": "urn:govuk-webmcp:schema:public-record-summary:v1" } },
        "boundaries": {
          "type": "object", "additionalProperties": false,
          "required": ["pageScoped", "readOnly", "providerCall", "durableReceiptCreated", "sourceDerivedContentIsUntrusted"],
          "properties": {
            "pageScoped": { "const": true },
            "readOnly": { "const": true },
            "providerCall": { "const": false },
            "durableReceiptCreated": { "const": false },
            "sourceDerivedContentIsUntrusted": { "const": true }
          }
        }
      }
    },
    { "$ref": "urn:govuk-webmcp:schema:combined-search-result:v2" },
    { "$ref": "urn:govuk-webmcp:schema:error-result:v1" }
  ]
}
