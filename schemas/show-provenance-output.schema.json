{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/show-provenance-output.schema.json",
  "title": "show_provenance output",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "ok", "recordId", "status", "observationDate", "extractionMethod", "sourceDigest", "recordDigest", "bundleDigest", "evidenceReceipt", "sources", "fieldAssertions", "limitations", "boundaries"],
      "properties": {
        "schema": { "const": "trusted-govuk-discovery.provenance-result.v1" },
        "ok": { "const": true },
        "recordId": { "type": "string", "maxLength": 128, "pattern": "^govuk-discovery:[a-z0-9][a-z0-9._:-]{2,111}$" },
        "status": { "const": "digest-bound" },
        "observationDate": { "type": "string", "format": "date-time" },
        "extractionMethod": { "type": "string", "minLength": 1, "maxLength": 500 },
        "sourceLock": { "type": "string", "minLength": 1, "maxLength": 300 },
        "sourceDigest": { "$ref": "#/$defs/sha256" },
        "recordDigest": { "$ref": "#/$defs/sha256" },
        "bundleDigest": { "$ref": "#/$defs/sha256" },
        "evidenceReceipt": { "$ref": "urn:govuk-webmcp:schema:evidence-receipt:v1" },
        "sources": {
          "type": "array", "minItems": 1, "maxItems": 12,
          "items": { "$ref": "urn:govuk-webmcp:schema:profile-record:v1#/properties/provenance/properties/sources/items" }
        },
        "fieldAssertions": {
          "type": "array", "minItems": 1, "maxItems": 40,
          "items": { "$ref": "urn:govuk-webmcp:schema:profile-record:v1#/properties/assertions/items" }
        },
        "limitations": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
        "boundaries": {
          "type": "object", "additionalProperties": false,
          "required": ["receiptInspectedOnly", "sourceWasNotRefetched", "cryptographicSignatureVerified", "sourceDerivedContentIsUntrusted"],
          "properties": {
            "receiptInspectedOnly": { "const": true },
            "sourceWasNotRefetched": { "const": true },
            "cryptographicSignatureVerified": { "const": false },
            "sourceDerivedContentIsUntrusted": { "const": true }
          }
        }
      }
    },
    { "$ref": "urn:govuk-webmcp:schema:federated-provenance-result:v1" },
    { "$ref": "urn:govuk-webmcp:schema:error-result:v1" }
  ],
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
