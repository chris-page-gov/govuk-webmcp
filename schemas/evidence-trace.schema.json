{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:govuk-webmcp:schema:evidence-trace:v1",
  "title": "Evidence Trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "question",
    "answerSummary",
    "scope",
    "claimIds",
    "nodes",
    "edges",
    "traceDigest",
    "boundaries"
  ],
  "properties": {
    "schema": { "const": "trusted-govuk-discovery.evidence-trace.v1" },
    "id": { "$ref": "#/$defs/answerId" },
    "question": { "type": "string", "minLength": 10, "maxLength": 200 },
    "answerSummary": { "type": "string", "minLength": 20, "maxLength": 500 },
    "scope": { "type": "string", "minLength": 20, "maxLength": 500 },
    "claimIds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/claimId" }
    },
    "nodes": {
      "type": "array",
      "minItems": 8,
      "maxItems": 40,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "minItems": 7,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/edge" }
    },
    "traceDigest": { "$ref": "#/$defs/sha256" },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalNarrative",
        "pageScoped",
        "providerCall",
        "sourceRefetched",
        "eligibilityDecision",
        "singleTrustScore"
      ],
      "properties": {
        "canonicalNarrative": { "const": false },
        "pageScoped": { "const": true },
        "providerCall": { "const": false },
        "sourceRefetched": { "const": false },
        "eligibilityDecision": { "const": false },
        "singleTrustScore": { "const": false }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "answerId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 96,
      "pattern": "^answer:[a-z0-9][a-z0-9-]{2,88}$"
    },
    "claimId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 96,
      "pattern": "^claim:[a-z0-9][a-z0-9-]{2,89}$"
    },
    "facets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "assertionStatus", "verification", "freshness", "integrity", "access", "rights", "coverage"],
      "properties": {
        "authority": { "type": "string", "minLength": 1, "maxLength": 200 },
        "assertionStatus": {
          "enum": ["official-source", "normalised", "inferred", "model-derived", "not-applicable"]
        },
        "verification": {
          "enum": ["digest-bound", "source-linked", "authored-boundary", "not-applicable"]
        },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["observed", "not-established", "not-applicable"] },
            "observedAt": { "type": "string", "format": "date-time" },
            "note": { "type": "string", "minLength": 1, "maxLength": 300 }
          }
        },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["sha256-bound", "not-applicable"] },
            "digest": { "$ref": "#/$defs/sha256" },
            "note": { "type": "string", "minLength": 1, "maxLength": 300 }
          }
        },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "note"],
          "properties": {
            "status": {
              "enum": ["public", "restricted", "authentication-required", "access-not-established", "not-applicable"]
            },
            "note": { "type": "string", "minLength": 1, "maxLength": 400 }
          }
        },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "note"],
          "properties": {
            "status": { "enum": ["confirmed", "missing", "conflicting", "not-applicable"] },
            "title": { "type": "string", "minLength": 1, "maxLength": 200 },
            "note": { "type": "string", "minLength": 1, "maxLength": 400 }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "note"],
          "properties": {
            "status": { "enum": ["bounded", "selected", "one-record", "not-applicable"] },
            "note": { "type": "string", "minLength": 1, "maxLength": 400 }
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "statement", "facets"],
      "properties": {
        "id": { "type": "string", "minLength": 3, "maxLength": 180, "pattern": "^[a-z]+:[a-z0-9][a-z0-9:._-]+$" },
        "kind": { "enum": ["answer", "claim", "source", "transformation", "check", "limitation"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "statement": { "type": "string", "minLength": 1, "maxLength": 600 },
        "recordId": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^govuk-discovery:[a-z0-9][a-z0-9._:-]{2,111}$" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "facets": { "$ref": "#/$defs/facets" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "answer" } }, "required": ["kind"] },
          "then": { "properties": { "id": { "$ref": "#/$defs/answerId" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "claim" } }, "required": ["kind"] },
          "then": { "properties": { "id": { "$ref": "#/$defs/claimId" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "source" } }, "required": ["kind"] },
          "then": { "properties": { "id": { "type": "string", "pattern": "^source:" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "transformation" } }, "required": ["kind"] },
          "then": { "properties": { "id": { "type": "string", "pattern": "^transformation:" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "check" } }, "required": ["kind"] },
          "then": { "properties": { "id": { "type": "string", "pattern": "^check:" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "limitation" } }, "required": ["kind"] },
          "then": { "properties": { "id": { "type": "string", "pattern": "^limitation:" } } }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target", "relation", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 3, "maxLength": 220, "pattern": "^edge:[a-z0-9][a-z0-9:._-]+$" },
        "source": { "type": "string", "minLength": 3, "maxLength": 180 },
        "target": { "type": "string", "minLength": 3, "maxLength": 180 },
        "relation": { "enum": ["supports", "derived-through", "verifies", "qualifies"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 }
      },
      "allOf": [
        {
          "if": { "properties": { "relation": { "const": "supports" } }, "required": ["relation"] },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "source": { "type": "string", "pattern": "^source:" },
                  "target": { "type": "string", "pattern": "^claim:" }
                }
              },
              {
                "properties": {
                  "source": { "type": "string", "pattern": "^claim:" },
                  "target": { "type": "string", "pattern": "^answer:" }
                }
              }
            ]
          }
        },
        {
          "if": { "properties": { "relation": { "const": "derived-through" } }, "required": ["relation"] },
          "then": {
            "properties": {
              "source": { "type": "string", "pattern": "^transformation:" },
              "target": { "type": "string", "pattern": "^claim:" }
            }
          }
        },
        {
          "if": { "properties": { "relation": { "const": "verifies" } }, "required": ["relation"] },
          "then": {
            "properties": {
              "source": { "type": "string", "pattern": "^check:" },
              "target": { "type": "string", "pattern": "^source:" }
            }
          }
        },
        {
          "if": { "properties": { "relation": { "const": "qualifies" } }, "required": ["relation"] },
          "then": {
            "properties": {
              "source": { "type": "string", "pattern": "^limitation:" },
              "target": { "type": "string", "pattern": "^(answer|claim):" }
            }
          }
        }
      ]
    }
  }
}
