{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:govuk-webmcp:schema:public-record-summary:v1",
  "title": "Bounded public record summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordId", "title", "description", "resourceType", "publisher", "accessStatus", "accessNote",
    "licenceStatus", "lastObserved", "assertionStatuses", "canonicalHumanUrl", "recordDigest",
    "bundleDigest", "evidenceReceiptId", "limitations"
  ],
  "properties": {
    "recordId": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^govuk-discovery:[a-z0-9][a-z0-9._:-]{2,111}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "resourceType": { "enum": ["govuk-content", "dataset", "api", "api-documentation", "catalogue-record", "organisation", "guidance"] },
    "publisher": { "type": "string", "minLength": 1, "maxLength": 200 },
    "accessStatus": { "enum": ["public", "restricted", "authentication-required", "access-not-established", "not-applicable"] },
    "accessNote": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "licenceStatus": { "enum": ["confirmed", "missing", "conflicting", "not-applicable"] },
    "licenceTitle": { "type": "string", "minLength": 1, "maxLength": 300 },
    "lastObserved": { "type": "string", "format": "date-time" },
    "assertionStatuses": {
      "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
      "items": { "enum": ["official-source", "normalised", "inferred", "model-derived"] }
    },
    "canonicalHumanUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "documentationUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "apiCatalogueUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "recordDigest": { "$ref": "#/$defs/sha256" },
    "bundleDigest": { "$ref": "#/$defs/sha256" },
    "evidenceReceiptId": { "type": "string", "pattern": "^trusted-govuk-discovery:evidence-receipt:sha256:[a-f0-9]{64}$" },
    "limitations": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
    "match": {
      "type": "object", "additionalProperties": false,
      "required": ["score", "matchedFields", "explanation"],
      "properties": {
        "score": { "type": "integer", "minimum": 1, "maximum": 216 },
        "matchedFields": {
          "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true,
          "items": { "enum": ["title", "description", "publisher", "topics", "resourceType"] }
        },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
