{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:govuk-webmcp:schema:evidence-receipt:v1",
  "title": "Trusted government knowledge discovery evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "observedAt", "sourceLock", "source", "output", "assertionStatuses", "limitations", "boundaries", "receiptDigest"],
  "properties": {
    "schema": { "const": "trusted-govuk-discovery.evidence-receipt.v1" },
    "id": { "type": "string", "pattern": "^trusted-govuk-discovery:evidence-receipt:sha256:[a-f0-9]{64}$" },
    "observedAt": { "type": "string", "format": "date-time" },
    "sourceLock": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "title", "publisher", "sourceDigest"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "title": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "sourceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["recordId", "recordDigest", "bundleDigest"],
      "properties": {
        "recordId": { "type": "string", "maxLength": 128, "pattern": "^govuk-discovery:[a-z0-9][a-z0-9._:-]{2,111}$" },
        "recordDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bundleDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "assertionStatuses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["official-source", "normalised", "inferred", "model-derived"] } },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "boundaries": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceWasNotRefetchedAtRuntime", "cryptographicSignatureVerified", "accessAuthorityGranted"],
      "properties": {
        "sourceWasNotRefetchedAtRuntime": { "const": true },
        "cryptographicSignatureVerified": { "const": false },
        "accessAuthorityGranted": { "const": false }
      }
    },
    "receiptDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
