{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/search-government-knowledge-input.schema.json",
  "title": "search_government_knowledge input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "resourceTypes": {
      "type": "array",
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/resourceType"
      }
    },
    "publishers": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "accessStatuses": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/accessStatus"
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "default": 8
    }
  },
  "required": [
    "query"
  ],
  "$defs": {
    "accessStatus": {
      "type": "string",
      "enum": [
        "public",
        "restricted",
        "authentication-required",
        "access-not-established",
        "not-applicable"
      ]
    },
    "assertionStatus": {
      "type": "string",
      "enum": [
        "official-source",
        "normalised",
        "inferred",
        "model-derived"
      ]
    },
    "resourceType": {
      "type": "string",
      "enum": [
        "govuk-content",
        "dataset",
        "api",
        "api-documentation",
        "catalogue-record",
        "organisation",
        "guidance"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ok",
        "error",
        "limitations"
      ],
      "properties": {
        "schema": {
          "const": "trusted-govuk-discovery.error.v1"
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "details"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "object"
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
