{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/show-provenance-output.schema.json",
  "title": "show_provenance output",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ok",
        "recordId",
        "status",
        "observationDate",
        "extractionMethod",
        "recordDigest",
        "bundleDigest",
        "sources",
        "fieldAssertions",
        "limitations",
        "boundaries"
      ],
      "properties": {
        "schema": {
          "const": "trusted-govuk-discovery.provenance-result.v1"
        },
        "ok": {
          "const": true
        },
        "recordId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "digest-bound",
            "unverified"
          ]
        },
        "observationDate": {
          "type": "string",
          "format": "date-time"
        },
        "extractionMethod": {
          "type": "string"
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "recordDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bundleDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidenceReceiptId": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "title",
              "publisher",
              "observedAt"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "title": {
                "type": "string"
              },
              "publisher": {
                "type": "string"
              },
              "observedAt": {
                "type": "string",
                "format": "date-time"
              },
              "digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "fieldAssertions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "boundaries": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "receiptInspectedOnly",
            "sourceWasNotRefetched",
            "cryptographicSignatureVerified",
            "sourceDerivedContentIsUntrusted"
          ],
          "properties": {
            "receiptInspectedOnly": {
              "const": true
            },
            "sourceWasNotRefetched": {
              "const": true
            },
            "cryptographicSignatureVerified": {
              "const": false
            },
            "sourceDerivedContentIsUntrusted": {
              "const": true
            }
          }
        }
      }
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "accessStatus": {
      "type": "string",
      "enum": [
        "public",
        "restricted",
        "authentication-required",
        "access-not-established",
        "not-applicable"
      ]
    },
    "assertionStatus": {
      "type": "string",
      "enum": [
        "official-source",
        "normalised",
        "inferred",
        "model-derived"
      ]
    },
    "resourceType": {
      "type": "string",
      "enum": [
        "govuk-content",
        "dataset",
        "api",
        "api-documentation",
        "catalogue-record",
        "organisation",
        "guidance"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ok",
        "error",
        "limitations"
      ],
      "properties": {
        "schema": {
          "const": "trusted-govuk-discovery.error.v1"
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "details"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "object"
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
